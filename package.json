{
  "name": "userscripts",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.12.4",
  "description": "A collection of userscripts for various purposes.",
  "author": "ryanuo <hi@ryanuo.cc>",
  "scripts": {
    "build": "unbuild && esno build-userscript.ts",
    "prepack": "unbuild && esno build-userscript.ts",
    "dev": "pnpm dlx serve",
    "lint": "eslint",
    "fix": "eslint . --fix",
    "release": "bumpp",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/node": "^20.19.20",
    "bumpp": "^10.3.1",
    "eslint": "^9.37.0",
    "esno": "^4.8.0",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "changelogithub": {
    "types": {
      "feat": {
        "title": "🚀 Features"
      },
      "fix": {
        "title": "🐞 Bug Fixes"
      },
      "perf": {
        "title": "🏎 Performance"
      },
      "refactor": {
        "title": "♻️ Refactors"
      },
      "docs": {
        "title": "📚 Documentation"
      },
      "build": {
        "title": "📦 Build"
      }
    }
  }
}
